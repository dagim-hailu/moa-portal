# ==========================================
# 1. RENDER ENVIRONMENT VARIABLES (Backend)
# ==========================================
# Add these exactly as shown in your Render Dashboard -> Environment Variables tab.

# Get this from your free Neon.tech account (Looks like postgres://user:password@hostname/dbname)
DATABASE_URL="postgres://your_neon_user:your_neon_password@ep-cool-butterfly-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Get this from your free Cloudinary Dashboard
CLOUDINARY_URL="cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME"

# A random secure string for user authentication (You can make this up, e.g. "super-secret-moa-key-2026")
JWT_SECRET="your_very_secret_random_string_here"

# The public URL Render gives you once the backend is created (Make sure there is NO trailing slash)
MOA_SERVER_URL="https://moa-server.onrender.com"

# PORT is optional on Render (Render injects it automatically), but good for local dev
PORT=4000


# ==========================================
# 2. VERCEL ENVIRONMENT VARIABLES (Frontend)
# ==========================================
# Add this in your Vercel Dashboard -> Project Settings -> Environment Variables.

# This MUST exactly match the URL Render gives you (Make sure there is NO trailing slash)
NEXT_PUBLIC_SERVER_URL="https://moa-server.onrender.com"

# The same secret used in the backend so Vercel can verify user sessions
JWT_SECRET="your_very_secret_random_string_here"
