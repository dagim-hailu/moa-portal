{
  "name": "@moa/shared",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./db/client": "./src/db/client.ts",
    "./db/seed": "./src/db/seed.ts",
    "./i18n": "./src/i18n/index.ts",
    "./theme": "./src/theme/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "echo 'lint shared'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-cli.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.33.0",
    "jose": "^5.6.2",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.2"
  }
}
