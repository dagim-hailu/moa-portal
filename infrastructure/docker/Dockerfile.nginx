FROM nginx:1.27-alpine

RUN apk add --no-cache bash gettext openssl

COPY infrastructure/nginx/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY infrastructure/nginx/entrypoint.sh /entrypoint.sh
COPY infrastructure/nginx/static /usr/share/nginx/html

RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
